# Copie para .env e preencha. Nunca comite o .env.

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# service_role key (Settings → API). Ignora RLS: é a correta para o backend.
SUPABASE_SERVICE_KEY=
# anon key (opcional, fallback)
SUPABASE_KEY=

# ── Evolution API ──────────────────────────────────────────
# SEM /manager no final — /manager é o frontend web, não a API.
EVOLUTION_API_URL=https://sua-evolution.exemplo.host
EVOLUTION_API_KEY=
# Nome da instância (não o UUID). Veja em GET /instance/fetchInstances.
EVOLUTION_INSTANCE=

# ── Aplicação ──────────────────────────────────────────────
# URL pública HTTPS, sem porta. Com ela o app aponta o webhook sozinho no boot.
PUBLIC_URL=https://seu-app.exemplo.host
PORT=3000
ALT_PORT=3001
TIMEZONE=America/Fortaleza
NODE_ENV=production

# ── Dashboard ──────────────────────────────────────────────
ADMIN_PASSWORD=troque-esta-senha

# ── Humanização ────────────────────────────────────────────
# Pausa aleatória antes de cada resposta, em ms (mostra "digitando…").
REPLY_DELAY_MIN_MS=3000
REPLY_DELAY_MAX_MS=5000
# Horas desde o último contato para o bot voltar a fazer triagem.
REARM_HOURS=24
# Intervalo do keepalive do Supabase, em horas (0 desativa).
# O plano free pausa projetos após 7 dias sem atividade.
KEEPALIVE_HOURS=6

# ── Testes ─────────────────────────────────────────────────
# Números tratados como teste: ficam ocultos em Solicitações e são apagados
# no boot. O próprio número da instância já entra automaticamente.
TEST_PHONES=
# Intervalo do monitor da conexão do WhatsApp, em segundos (0 desativa).
MONITOR_SECONDS=60
