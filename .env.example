# Copie para .env e preencha. Nunca comite o .env.

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# service_role key (Settings → API). Ignora RLS: é a correta para o backend.
SUPABASE_SERVICE_KEY=
# anon key não é usada pelo backend; mantenha vazia aqui.
SUPABASE_KEY=

# ── Evolution API ──────────────────────────────────────────
# SEM /manager no final — /manager é o frontend web, não a API.
EVOLUTION_API_URL=https://sua-evolution.exemplo.host
EVOLUTION_API_KEY=
# Nome da instância (não o UUID). Veja em GET /instance/fetchInstances.
EVOLUTION_INSTANCE=
# Opcional: segredo exclusivo do webhook. Se vazio, o app deriva um token
# irreversível da EVOLUTION_API_KEY e configura a Evolution automaticamente.
EVOLUTION_WEBHOOK_SECRET=

# ── Aplicação ──────────────────────────────────────────────
# URL pública HTTPS, sem porta. Com ela o app aponta o webhook sozinho no boot.
PUBLIC_URL=https://seu-app.exemplo.host
PORT=3000
ALT_PORT=3001
TIMEZONE=America/Fortaleza
NODE_ENV=production

# ── Dashboard ──────────────────────────────────────────────
ADMIN_PASSWORD=troque-esta-senha

# ── Humanização ────────────────────────────────────────────
# Pausa aleatória antes de cada resposta, em ms (mostra "digitando…").
REPLY_DELAY_MIN_MS=3000
REPLY_DELAY_MAX_MS=5000
# Horas desde o último contato para o bot voltar a fazer triagem.
REARM_HOURS=24
# Intervalo do keepalive do Supabase, em horas (0 desativa).
# O plano free pausa projetos após 7 dias sem atividade.
KEEPALIVE_HOURS=6

# ── Testes ─────────────────────────────────────────────────
# Números tratados como teste: ficam ocultos em Solicitações e são apagados
# no boot. O próprio número da instância já entra automaticamente.
TEST_PHONES=
# Intervalo do monitor da conexão do WhatsApp, em segundos (0 desativa).
MONITOR_SECONDS=60
# Retomada após queda: só se a conexão ficou fora por este tempo (minutos),
# e no máximo este número de conversas por vez.
RECOVERY_MIN_MINUTES=5
RECOVERY_MAX=20

# Para o bot inteiro somente após recusas consecutivas reais.
# ACK duplicado/desconhecido não entra nesta contagem.
FREIO_REJEICOES=3
# O freio global só engata se as recusas atingirem também esta quantidade de
# destinatários distintos. Um contato inválido não silencia todos os demais.
FREIO_DESTINOS_MIN=3
# Recusas seguidas que isolam apenas aquele destinatário.
FREIO_DESTINO_REJEICOES=2

# Tempo máximo que o painel espera pelo ACK real de uma sonda (ms).
SONDA_TIMEOUT_MS=25000

# ── Banco exclusivo de testes (recomendado) ─────────────────
# npm test e npm run carga nunca usam estas credenciais no navegador e nunca
# chamam a Evolution real. Se ausentes, o banco principal só é aceito com o
# opt-in explícito indicado pelos próprios scripts.
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_KEY=
# E2E_ALLOW_SHARED_SUPABASE=I_UNDERSTAND
# CARGA_ALLOW_SHARED_SUPABASE=I_UNDERSTAND
